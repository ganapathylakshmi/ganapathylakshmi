              "pm.variables.set(\"randomNumber\", randomNumber);\r",
              "\r",
              "console.log(\"Random Number:\", randomNumber);\r",
              "//first Order for pre request : collection/folder/request\r",
              "\r",
              "//second Order for test scripts: collection/folder/request\r",
              "\r",
              "\r",
              "//to create global variable\r",
              "pm.globals.set(\"Var_global1\", randomNumber.toString()\r",
              "\r",
              "//to remove global variable\r",
