  "item": [
    {
      "name": "All Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () \r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "}\r",
              ");\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", function ()\r",
              "\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "}\r",
              ");\r",
              "pm.test(\"Verify the response code is OK using constant\", ()=>\r",
              "{\r",
              "    const exptcode = \"OK\";\r",
              "    pm.response.to.have.status(exptcode);   \r",
              "}\r",
              ");\r",
              "\r",
              "pm.test(\"the end point does not return unexpected status\", function()\r",
              "{\r",
              "    pm.expect(pm.response.to.not.have.status(404));\r",
              "}\r",
              ");\r",
              "pm.test(\"To Validate multiple response code\", ()=>\r",
              "{\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);\r",
              "}\r",
              "\r",
              ");\r",
              "\r",
              "pm.test(\"To validate the body\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.text()).to.include(\"Ashton Cox\");\r",
              "}\r",
              ");\r",
              "\r",
              "pm.test(\"To validate whether cookies is present\" , function()\r",
              "{\r",
              "    pm.expect(pm.cookies.get(\"cookie\")).to.not.be.null;\r",
              "}\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
